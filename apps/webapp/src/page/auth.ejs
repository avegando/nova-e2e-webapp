<!-- <%= VERSION %> -->
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#05070a" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nova E2E" />
    <link href="/image/meta/apple-touch-icon-180-v2.png" rel="apple-touch-icon" />
    <link href="/image/meta/apple-touch-icon-180-v2.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/image/meta/apple-touch-icon-167-v2.png" rel="apple-touch-icon" sizes="167x167" />
    <link href="/image/meta/apple-touch-icon-152-v2.png" rel="apple-touch-icon" sizes="152x152" />
    <link href="/image/meta/apple-touch-icon-120-v2.png" rel="apple-touch-icon" sizes="120x120" />
    <link href="/image/meta/site.webmanifest?v=2" rel="manifest" />
    <meta name="geoip" content="{{ country }}" />
    <link href="/image/favicon-v2.ico" type="image/x-icon" rel="shortcut icon" sizes="48x48" />
    <link href="/image/meta/novae2e-icon-256-v2.png" rel="icon" sizes="256x256" type="image/png" />
    <link href="/image/meta/novae2e-icon-128-v2.png" rel="icon" sizes="128x128" type="image/png" />
    <link href="/image/meta/novae2e-icon-64-v2.png" rel="icon" sizes="64x64" type="image/png" />
    <link href="/image/meta/novae2e-icon-32-v2.png" rel="icon" sizes="32x32" type="image/png" />

    <meta property="og:title" content="<%= OPEN_GRAPH_TITLE %>" />
    <meta property="og:description" name="description" content="<%= OPEN_GRAPH_DESCRIPTION %>" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= APP_BASE %>" />
    <meta property="og:image" content="<%= OPEN_GRAPH_IMAGE_URL %>" />

    <title><%= BRAND_NAME %></title>

    <script src="../min/basicBrowserFeatureCheck.js?v=<%= VERSION %>"></script>
    <script src="../min/checkBrowser.js?v=<%= VERSION %>"></script>

    <script src="../libs/wire/telemetry/embed.js"></script>
    <link href="../min/core-crypto-ffi_bg.wasm" rel="prefetch" />
    <style id="nova-input-base">
      /* NovaE2E: every text field on every page is dark with light text, also in Safari and when the browser fills it in. */
      :root{color-scheme:dark}
      input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=file]):not([type=color]),textarea,select{background-color:#1a1d22!important;color:#f2f4f7!important;-webkit-text-fill-color:#f2f4f7!important;caret-color:#22d3ee!important;border:1px solid rgba(200,208,216,.42)!important;-webkit-appearance:none;appearance:none;color-scheme:dark}
      input:not([type=checkbox]):not([type=radio]):focus,textarea:focus{border-color:#22d3ee!important;outline:none}
      input::placeholder,textarea::placeholder{color:#aab4be!important;-webkit-text-fill-color:#aab4be!important;opacity:1!important}
      input:-webkit-autofill,input:-webkit-autofill:hover,input:-webkit-autofill:focus,textarea:-webkit-autofill{-webkit-box-shadow:0 0 0 1000px #1a1d22 inset!important;box-shadow:0 0 0 1000px #1a1d22 inset!important;-webkit-text-fill-color:#f2f4f7!important;caret-color:#22d3ee!important;transition:background-color 99999s ease-out}
      [contenteditable="true"],[contenteditable=""]{caret-color:#22d3ee!important;color:#f2f4f7;-webkit-text-fill-color:currentColor}
    </style>
  </head>

  <body>
    <div id="main"></div>
    <script src="../config.js"></script>
    <script src="../min/dexie.js?v=<%= VERSION %>"></script>
    <script src="../min/vendor.js?v=<%= VERSION %>"></script>
    <script src="../min/runtime.js?v=<%= VERSION %>"></script>
    <script src="../min/auth.js?v=<%= VERSION %>"></script>
  </body>
</html>
